SOLVER_URL=http://localhost:5001

# Base URL for this app. Used to build the CWRU SSO callback URL.
# Dev: APP_BASE_URL=http://localhost:3000
# Prod: APP_BASE_URL=https://course-scheduler.xlab-cwru.com
APP_BASE_URL=https://course-scheduler.xlab-cwru.com

# Secret used to sign auth JWTs. Must be 32+ random bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-random-string

# Optional. Must match solver SOLVER_ACCESS_KEY when that is set.
# Sent as X-Solver-Access-Key on /access/* calls.
# SOLVER_ACCESS_KEY=
