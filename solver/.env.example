# Database backend: "sqlite" (default) or "postgres"
DB_BACKEND=sqlite

# Required when DB_BACKEND=postgres.
# Example for AWS Lightsail PostgreSQL:
# DATABASE_URL=postgresql://dbmasteruser:<password>@<host>.us-east-1.rds.amazonaws.com:5432/course_scheduler
# (The app auto-rewrites postgresql:// to postgresql+psycopg:// for the psycopg3 driver.)
DATABASE_URL=

# Optional shared secret for /access/* allowlist endpoints.
# When set, platform must send the same value as header X-Solver-Access-Key.
# SOLVER_ACCESS_KEY=

# --- Production networking (Vercel → this solver) ---
# /solve holds an HTTP connection open with no response bytes until CP-SAT
# finishes (up to SOLVER_MAX_TIME_SECONDS, currently 180s). If a load balancer,
# nginx, or cloud firewall in front of this process uses a short idle timeout
# (AWS ALB default is 60s), Vercel will see intermittent 502 / ETIMEDOUT /
# ECONNRESET — often ~half the runs, whichever searches longer than the idle
# limit. Set idle/read timeouts on that proxy to at least 300 seconds.
